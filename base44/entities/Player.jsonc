{
  "name": "Player",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Player full name"
    },
    "last_name": {
      "type": "string",
      "description": "Player last name"
    },
    "photo_url": {
      "type": "string",
      "description": "Player photo URL"
    },
    "team": {
      "type": "string",
      "description": "Team name"
    },
    "team_color": {
      "type": "string",
      "enum": [
        "red",
        "blue"
      ],
      "description": "Team color indicator"
    },
    "overall_rating": {
      "type": "number",
      "description": "Overall FIFA-style rating (0-99)"
    },
    "position": {
      "type": "string",
      "description": "Playing position with detailed role"
    },
    "jersey_number": {
      "type": "number",
      "description": "Jersey number"
    },
    "nationality": {
      "type": "string",
      "description": "Player nationality (flag emojis)"
    },
    "appearances": {
      "type": "number",
      "default": 0,
      "description": "Total appearances"
    },
    "goals": {
      "type": "number",
      "default": 0,
      "description": "Goals scored"
    },
    "assists": {
      "type": "number",
      "default": 0,
      "description": "Assists"
    },
    "yellow_cards": {
      "type": "number",
      "default": 0,
      "description": "Yellow cards"
    },
    "red_cards": {
      "type": "number",
      "default": 0,
      "description": "Red cards"
    },
    "potms": {
      "type": "number",
      "default": 0,
      "description": "Player of the Match awards"
    },
    "average_goals_per_game": {
      "type": "number",
      "description": "Average goals per game"
    },
    "goalkeeper_save_percentage": {
      "type": "number",
      "description": "Goalkeeper save percentage (0-100)"
    },
    "clean_sheet_chance": {
      "type": "number",
      "description": "Chance of clean sheet percentage (0-100)"
    }
  },
  "required": [
    "name"
  ]
}