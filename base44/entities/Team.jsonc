{
  "name": "Team",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Team name"
    },
    "logo_url": {
      "type": "string",
      "description": "Team logo image URL"
    },
    "played": {
      "type": "number",
      "default": 0,
      "description": "Games played"
    },
    "won": {
      "type": "number",
      "default": 0,
      "description": "Games won"
    },
    "drawn": {
      "type": "number",
      "default": 0,
      "description": "Games drawn"
    },
    "lost": {
      "type": "number",
      "default": 0,
      "description": "Games lost"
    },
    "goals_for": {
      "type": "number",
      "default": 0,
      "description": "Goals scored"
    },
    "goals_against": {
      "type": "number",
      "default": 0,
      "description": "Goals conceded"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Total points"
    }
  },
  "required": [
    "name"
  ]
}
